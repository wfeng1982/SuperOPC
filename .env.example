# SuperOPC Configuration

# Application
APP_NAME=SuperOPC
DEBUG=false

# Server
HOST=127.0.0.1
PORT=8000

# Workspace
WORKSPACE_ROOT=~/.superopc

# Browser
BROWSER_PORT=12321
BROWSER_WS_PORT=22321
HEADLESS=true

# Database
DB_URL=sqlite:///superopc.db

# Models
DEFAULT_MODEL_PROVIDER=ollama
DEFAULT_MODEL_NAME=mistral
OLLAMA_BASE_URL=http://localhost:11434

# Logging
LOG_LEVEL=INFO

# Features
ENABLE_BROWSER_AUTOMATION=true
ENABLE_RAG=true
ENABLE_SCHEDULING=true